{
  "name": "slidev-theme-haven",
  "version": "0.1.0",
  "description": "A cosy autumn-forest Slidev theme for Hack Club Haven game jams",
  "author": "Ingo Wolf (https://github.com/ingoau)",
  "license": "MIT",
  "homepage": "https://github.com/ingoau/slidev-theme-haven#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingoau/slidev-theme-haven.git"
  },
  "bugs": {
    "url": "https://github.com/ingoau/slidev-theme-haven/issues"
  },
  "keywords": [
    "slidev-theme",
    "slidev",
    "hack-club",
    "haven",
    "game-jam"
  ],
  "engines": {
    "node": ">=18.0.0",
    "slidev": ">=53.0.0"
  },
  "files": [
    "layouts",
    "components",
    "styles",
    "assets",
    "fonts",
    "setup",
    "layoutHelper.ts",
    "uno.config.ts",
    "vite.config.ts"
  ],
  "scripts": {
    "dev": "slidev example.md",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "fonts": {
        "sans": "Jua",
        "serif": "Darumadrop One",
        "mono": "Fira Code",
        "local": [
          "Jua",
          "Darumadrop One"
        ]
      },
      "transition": "slide-left"
    }
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "playwright-chromium": "^1.64.0"
  }
}
